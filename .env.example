# ============================================================
# 智慧问诊Agent系统 环境配置
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 含敏感信息，已加入 .gitignore，切勿提交
# ============================================================

# ===== LLM 配置（主模型：意图识别/症状检测/知识问答等全部 Agent）=====
# 使用阿里云 DashScope 的 OpenAI 兼容模式
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=your_api_key_here
MODEL_NAME=qwen-plus
# 主模型单次最大输出 Token；防止异常长回答挤占后续上下文
MODEL_MAX_OUTPUT_TOKENS=2048

# ===== 抽取模型配置（实体/关系抽取可切换到自部署 vLLM 微调模型）=====
# 留空 = 回退主 LLM（云端）；填入 vLLM 地址后仅抽取走本地微调模型，其余 Agent 仍走云端
# 模式A（全部云端）：EXTRACTION_MODEL_BASE_URL=
# 模式B（抽取走本地 vLLM）：
#   EXTRACTION_MODEL_BASE_URL=http://<你的GPU地址>:8000/v1
#   EXTRACTION_MODEL_API_KEY=EMPTY
#   EXTRACTION_MODEL_NAME=qwen2.5-merged
# 注意：base_url 必须写全 http:// + 端口 + /v1；NAME 必须与 vLLM --served-model-name 一致
EXTRACTION_MODEL_BASE_URL=
EXTRACTION_MODEL_API_KEY=
EXTRACTION_MODEL_NAME=

# ===== Neo4j 图数据库配置 =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# ===== Redis 热缓存（短期记忆：最近12轮 + TTL 24h）=====
REDIS_URL=redis://localhost:6379/0

# ===== MySQL 冷存储（长期记忆：全量对话历史，唯一事实源）=====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=smc_history

# ===== 向量模型配置（本地 BGE-M3，1024 维）=====
EMBEDDING_MODEL_PATH=models/bge-m3

# ===== 日志配置 =====
LOG_LEVEL=INFO
